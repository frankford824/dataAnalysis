# Copy to .env for local development. Generate fresh production secrets with:
#   ./scripts/generate-env.sh > .env
APP_ENV=development
POSTGRES_DB=commerce
POSTGRES_USER=commerce
POSTGRES_PASSWORD=commerce-dev-only
ANALYTICS_READER_PASSWORD=analytics-dev-only
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin-dev-only
APP_SECRET_KEY=development-only-change-me
# A Fernet key; do not reuse this development value in production.
APP_ENCRYPTION_KEY=mD9rPz9D1Gm1pj6uOvBtwxSVtvzRLRk8P4n4zAL1L7o=
SUPERSET_SECRET_KEY=development-superset-secret-change-me
SUPERSET_GUEST_TOKEN_SECRET=development-guest-secret-change-me
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=admin-dev-only
SUPERSET_ADMIN_EMAIL=admin@example.invalid
SUPERSET_EMBED_ALLOWED_DOMAINS=http://localhost:3000
SESSION_COOKIE_SECURE=false
# Ingestion safety limits: 100 MiB upload, 500 MiB expanded ZIP, 5M rows.
COMMERCE_MAX_UPLOAD_BYTES=104857600
COMMERCE_MAX_UNCOMPRESSED_BYTES=524288000
COMMERCE_MAX_INPUT_ROWS=5000000

# Browser setup is the normal first-run path. These values are ignored unless
# DEMO_AUTO_SETUP=true is explicitly exported (demo-reset.sh does that).
DEMO_AUTO_SETUP=false
DEMO_ENTERPRISE_NAME='Example Outdoor Retail'
DEMO_ADMIN_NAME='Example Platform Administrator'
DEMO_ADMIN_EMAIL=demo-admin@example.invalid
DEMO_ADMIN_PASSWORD=development-demo-only

# disabled, cloud, or local. The default stack does not start LiteLLM.
AI_MODE=disabled
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=
# Only set provider keys on installations that explicitly enable cloud AI.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

BACKEND_PORT=8000
WEB_PORT=3000
SUPERSET_PORT=8088
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
POSTGRES_PORT=5432
LITELLM_PORT=4000
# Defaults expose no service beyond the local host. A host reverse proxy should
# be the only production ingress and should forward to WEB_BIND_ADDRESS.
MANAGEMENT_BIND_ADDRESS=127.0.0.1
WEB_BIND_ADDRESS=127.0.0.1

S3_REGION=us-east-1
S3_RAW_BUCKET=commerce-raw
S3_INTERMEDIATE_BUCKET=commerce-intermediate
S3_EXPORT_BUCKET=commerce-exports
PUBLIC_API_BASE_URL=/api/v1
# Browser-visible Superset origin. Use the customer BI hostname in production.
PUBLIC_SUPERSET_URL=http://localhost:8088
